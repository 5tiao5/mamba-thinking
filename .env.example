# Copy this file to `.env` in the same folder and fill in your local secrets.
# The backend launcher and FastAPI app will automatically load `product_agent/.env`.

# Required if you want LLM-powered report / summary / idea generation.
OPENAI_API_KEY=

# Optional fallback: OpenAI-compatible DeepSeek endpoint.
DEEPSEEK_API_KEY=

# Optional: raises Semantic Scholar rate limits for multi-source retrieval.
S2_API_KEY=

# Optional backend configuration.
PRODUCT_AGENT_STORAGE=sqlite
PRODUCT_AGENT_SQLITE_PATH=./data/product_agent.db

# Optional feature flags for local debugging.
# Full mode enables citation enrichment by default. Set to 0 only when debugging
# offline or when Semantic Scholar latency must be avoided.
# CITATION_ENRICHMENT=0
# FULLTEXT_RELATIONSHIP_VERIFICATION=0
# FULLTEXT_RELATIONSHIP_MAX_EDGES=2
# SKIP_AUDITOR_LLM=1
# SKIP_REPORT_LLM=1
# SKIP_SUMMARY_LLM=1

# Agent repair controls. The default allows two targeted re-search rounds, but
# stops early when papers, alignment, and gap coverage no longer improve.
# AGENT_MAX_REPAIR_ROUNDS=2
# AGENT_MIN_ALIGNMENT_GAIN=0.03
# AGENT_MAX_CONTROLLER_STEPS=17
